#1- Paste the command and press Enter:
#Bash
curl -L https://github.com/GenomicsAotearoa/introduction-to-shell/releases/download/2024-July/shell_data.zip -o shell_data.zip


#2- Unzip the file: Once the download is finished (you'll see a progress bar finish), you must unpack it:
#Bash
unzip shell_data.zip

#3-Go into the data folder:
#Bash
cd shell_data
